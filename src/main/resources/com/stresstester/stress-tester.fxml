<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.stresstester.StressTesterController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <GridPane hgap="20" vgap="20">
        <TextArea fx:id="solutionTextArea" GridPane.rowIndex="0" GridPane.columnIndex="0"
                  promptText="Solution Code" prefWidth="800" prefHeight="400"/>

        <TextArea fx:id="bruteForceTextArea" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  promptText="Brute Force Code" prefWidth="800" prefHeight="400"/>

        <TextArea fx:id="testCaseGeneratorTextArea" GridPane.rowIndex="1" GridPane.columnIndex="0"
                  promptText="Test Case Generator" prefWidth="800" prefHeight="400"/>

        <TextArea fx:id="outputTextArea" GridPane.rowIndex="1" GridPane.columnIndex="1"
                  promptText="Output" editable="false" prefWidth="800" prefHeight="400"/>
    </GridPane>

    <HBox spacing="20">
        <Button text="Start" onAction="#start" prefWidth="100"/>
    </HBox>
</VBox>
